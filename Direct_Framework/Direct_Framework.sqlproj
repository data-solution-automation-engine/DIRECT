<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.0.0-preview.2" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <!-- version definitions, dsp monikers and reference dacpac names:
      https://github.com/microsoft/dacfx
      https://learn.microsoft.com/en-us/sql/tools/sql-database-projects/concepts/target-platform
      Microsoft.Build.SQL Sdk package versions:
      https://www.nuget.org/packages/Microsoft.Build.Sql#versions-body-tab
      Dotnet Sdk for building project:
      https://dotnet.microsoft.com/en-us/download
      Properties for this property group:
      https://learn.microsoft.com/en-us/sql/tools/sql-database-projects/concepts/project-properties
    -->
    <AssemblyName>Direct_Framework</AssemblyName>
    <CompatibilityMode>$(CompatibilityMode)</CompatibilityMode>
    <DacDescription>https://github.com/data-solution-automation-engine/DIRECT</DacDescription>
    <DacVersion>$(DacVersion)</DacVersion>
    <DefaultCollation>$(DefaultCollation)</DefaultCollation>
    <DefaultFilegroup>PRIMARY</DefaultFilegroup>
    <DefaultFileStructure>BySchemaAndSchemaType</DefaultFileStructure>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <IncludeSchemaNameInFileName>True</IncludeSchemaNameInFileName>
    <ModelCollation>$(ModelCollation)</ModelCollation>
    <Name>Direct_Framework</Name>
    <OutputType>Database</OutputType>
    <ProjectGuid>{b88ff268-22f9-4416-9e36-cfe598d243eb}</ProjectGuid>
    <RootNamespace>Direct_Framework</RootNamespace>
    <RunSqlCodeAnalysis>True</RunSqlCodeAnalysis>
    <TargetDatabaseSet>True</TargetDatabaseSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <!-- Fail on warnings when building a Release -->
    <TreatTSqlWarningsAsErrors>True</TreatTSqlWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="DeploymentScripts\1-PreDacpacDeployment\Migrations\Migration-vNext.sql" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dacpac internal pre and post-deployments -->
    <PreDeploy Include="DeploymentScripts\2-PreDeployment\Script.PreDeployment.sql" />
    <PostDeploy Include="DeploymentScripts\3-PostDeployment\Script.PostDeployment.sql" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pre-deployment migration scripts -->
    <None Include="DeploymentScripts\1-PreDacpacDeployment\Migrations\Migration-vNext.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="DeploymentScripts\1-PreDacpacDeployment\PreDacpacDeployment.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="DeploymentScripts\1-PreDacpacDeployment\Migrations\Migration-2.0.0.0.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="DeploymentScripts\1-PreDacpacDeployment\Migrations\Migration-1.9.2.0.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="DeploymentScripts\1-PreDacpacDeployment\Migrations\Migration-1.9.1.0.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Post-deployment maintenance scripts -->
    <None Include="DeploymentScripts\4-PostDacpacDeployment\PostDacpacDeployment.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- auxiliary files and scripts not part of dacpac database package -->
    <None Include="StaticCodeAnalysis.SuppressMessages.xml" />
    <None Include="BuildScripts\PostBuild.cmd" />
    <None Include="BuildScripts\PostBuild.ps1" />
    <None Include="BuildScripts\PreBuild.cmd" />
    <None Include="BuildScripts\PreBuild.ps1" />
    <None Include="DeploymentScripts\readme.md" />
    <None Include="Stored Procedures\omd.EndDating.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.AREA.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.EVENT_TYPE.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.EXECUTION_STATUS.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.FRAMEWORK_METADATA.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.FREQUENCY.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.INTERNAL_PROCESSING_STATUS.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.LAYER.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd_metadata.NEXT_RUN_STATUS.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd.BATCH_INSTANCE.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd.BATCH.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd.MODULE_INSTANCE_EXECUTED_CODE.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd.MODULE_INSTANCE.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\omd.MODULE.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\Queue_Job_Batch.sql" />
    <None Include="DeploymentScripts\3-PostDeployment\Queue_Job_Module.sql" />
  </ItemGroup>

  <!-- <ItemGroup>
    <Folder Include="BuildScripts\" />
    <Folder Include="DeploymentScripts\" />
    <Folder Include="DeploymentScripts\1-PreDacpacDeployment\" />
    <Folder Include="DeploymentScripts\1-PreDacpacDeployment\Migrations\" />
    <Folder Include="DeploymentScripts\2-PreDeployment\" />
    <Folder Include="DeploymentScripts\3-PostDeployment\" />
    <Folder Include="DeploymentScripts\4-PostDacpacDeployment\" />
    <Folder Include="Functions\" />
    <Folder Include="Schemas\" />
    <Folder Include="Stored Procedures\" />
    <Folder Include="Tables\" />
    <Folder Include="Views\" />
  </ItemGroup> -->
  <!-- <ItemGroup>
    <Build Include="Functions/*" />
    <Build Include="Schemas/*" />
    <Build Include="Stored Procedures/*" />
    <Build Include="Tables/*" />
    <Build Include="Views/*" />
  </ItemGroup> -->
  <Target Name="RunPreBuild" BeforeTargets="Build">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/BuildScripts/PreBuild.cmd&quot; $(Configuration)" />
  </Target>
  <Target Name="RunPostBuild" AfterTargets="Build">
    <Exec Command="&quot;$(MSBuildProjectDirectory)/BuildScripts/PostBuild.cmd&quot; $(Configuration)" />
  </Target>
  <!-- This below deletion is only needed in sql sdk version 1.0.0 when building
       in Visual Studio w dotnet 8/9 atm
       in dotnet 10 and sql sdk 2.0.0 preview it is solved, but that comes with other errors atm.
       When dotnet 10 and sql sdk v2 is released this should be revisited/removed,
       else there will probably be other build errors... -->
  <Target Name="DeleteProjectAssetsJson" BeforeTargets="BeforeBuild" Condition="'$(BuildingInsideVisualStudio)' == 'true'">
    <Delete Files="$(MSBuildProjectDirectory)\obj\project.assets.json" />
  </Target>
    <ItemGroup>
    <!-- The ErikEJ packages currently has limited business rules and no mute function for them -->
    <!-- <PackageReference Include="ErikEJ.DacFX.SqlServer.Rules" >
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference> -->
    <!-- <PackageReference Include="ErikEJ.DacFX.TSQLSmellSCA" >
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference> -->
    <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master">
      <GeneratePathProperty>True</GeneratePathProperty>
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
    </PackageReference>
    </ItemGroup>
      <PropertyGroup>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
  </PropertyGroup>
</Project>
