<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.0.0-preview.2" />
  <PropertyGroup>
    <TargetDatabaseName>Direct_Framework_tsqlt_Tests</TargetDatabaseName>
    <ModelCollation>$(ModelCollation)</ModelCollation>
    <DacVersion>$(DacVersion)</DacVersion>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ProjectGuid>{1c2116bc-e467-8272-712c-072dc61519d0}</ProjectGuid>
    <TargetDatabaseSet>True</TargetDatabaseSet>
  </PropertyGroup>
  <ItemGroup>
    <Build Remove="tSQLt\Example.sql" />
    <Build Remove="tSQLt\PrepareServer.sql" />
    <Build Remove="tSQLt\tSQLt.class.sql" />
  </ItemGroup>
  <!-- bring in the tSQLt framework during publish -->
  <ItemGroup>
    <PreDeploy Include="PreDeploy_Install_tSQLt.sql" />
  </ItemGroup>
  <!-- <ItemGroup>
    <Build Include="Schemas\omd_Tests.sql" />
  </ItemGroup> -->
  <ItemGroup>
    <Folder Include="Schemas" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tSQLt\Example.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="tSQLt\PrepareServer.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="tSQLt\tSQLt.class.sql">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Direct_Framework\Direct_Framework.sqlproj" />
  </ItemGroup>
  <ItemGroup>
      <PackageReference Include="Microsoft.SqlServer.Dacpacs.Master" >
      <GeneratePathProperty>True</GeneratePathProperty>
      <DatabaseVariableLiteralValue>master</DatabaseVariableLiteralValue>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
    <SqlCodeAnalysisRules>-Microsoft.Rules.Data.NETSDK1057;-NETSDK1057;</SqlCodeAnalysisRules>
  </PropertyGroup>
  <PropertyGroup>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
  </PropertyGroup>
</Project>
